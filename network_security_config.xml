<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite http (sem TLS) para a Roku na rede local, que normalmente nao tem HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
