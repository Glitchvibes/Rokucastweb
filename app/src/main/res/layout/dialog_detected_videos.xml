<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/panel_dark" android:padding="12dp">
    <TextView android:id="@+id/emptyLabel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/no_videos_found"
        android:textColor="@color/text_muted" android:padding="12dp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/videoList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <CheckBox android:id="@+id/checkAiUpscale" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="AI UPSCALE NA NUVEM (2x) — Real-ESRGAN"
        android:textColor="@color/text_white" android:buttonTint="@color/accent_teal" android:padding="8dp" />
    <Button android:id="@+id/btnCastCurrentPage" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/cast_current_page" android:backgroundTint="@color/accent_teal"
        android:textColor="@color/bg_dark" />
</LinearLayout>
